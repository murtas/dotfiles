[user]
  email = murtas@gmail.com
  name = Diogo F. Andrade Murteira
  signingkey = F4CE3C58ACB076C4
[core]
  editor = nvim
  pager = delta
  excludesfile = ~/.gitignore_global
[alias]
  st = status
  ci = commit
  br = branch
  co = checkout
  df = diff
  lg = log -p
  hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
  type = cat-file -t
  dump = cat-file -p
[color]
  ui = true
[commit]
  gpgsign = true
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true  # use n and N to move between diff sections
  features = decorations
  syntax-theme = Dracula
  side-by-side = false
  line-numbers = true
[delta "decorations"]
  commit-decoration-style = bold yellow box
  file-style = bold yellow
  file-decoration-style = none
  hunk-header-style = cyan bold
[merge]
  conflictstyle = diff3
[diff]
  colorMoved = default
[pager]
  diff = delta
  log = delta
  reflog = delta
  show = delta
[pull]
  rebase = true
